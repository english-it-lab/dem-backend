APP_NAME=Digital Event Manager API
API_V1_PREFIX=/api/v1
ENVIRONMENT=local

# Database. `localhost` targets `docker compose up db`; the api service in
# docker-compose.yml overrides DB_HOST=db on its own.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=digital_events
DB_ECHO=false

# Browser origins allowed to call the API directly (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Email confirmation
EMAIL_CONFIRMATION_SECRET_KEY=test-email-confirmation-secret

# SMTP configuration
EMAIL_PASSWORD=pass
EMAIL_LOGIN=login@yandex.ru
SMTP_SERVER=smtp.yandex.ru
SMTP_PORT=587

# JWT configuration
JWT_SECRET_KEY=secret
JWT_TTL_MINUTES=1440
